{
  "manifest_version": 3,
  "name": "Aiva Nex Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device screen understanding assistant (SIH prototype). Detects and redacts sensitive data locally before sending anonymized context to a server.",
  "action": {
    "default_title": "Aiva Nex Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["memory.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["activeTab", "tabs", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"]
}
